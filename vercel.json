{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/parse",
      "destination": "/api/report-parser.py"
    },
    {
      "source": "/api/match-labels",
      "destination": "/api/report-parser.py"
    },
    {
      "source": "/api/healthz",
      "destination": "/api/report-parser.py"
    },
    {
      "source": "/api/ocr-readyz",
      "destination": "/api/report-parser.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60
    }
  }
}